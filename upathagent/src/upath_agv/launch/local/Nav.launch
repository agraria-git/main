<?xml version="1.0"?>

<launch>

  <arg name="no_static_map" default="true"/>
  
  <arg name="base_global_planner" default="waypoint_global_planner/WaypointGlobalPlanner"/>

  <arg name="base_local_planner" default="base_local_planner/TrajectoryPlannerROS"/>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">

    <param name="base_global_planner" value="waypoint_global_planner/WaypointGlobalPlanner"/>
    <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>  
   
    <rosparam file="$(find main_agv)/params/param/nav/planner.yaml" command="load"/>

    <!-- observation sources located in costmap_common.yaml -->
    <rosparam file="$(find main_agv)/params/param/nav/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find main_agv)/params/param/nav/costmap_common.yaml" command="load" ns="local_costmap" />

    <!-- local costmap, needs size -->
    <rosparam file="$(find main_agv)/params/param/nav/costmap_local.yaml" command="load" ns="local_costmap" />

    <!-- static global costmap, static map provides size -->
    <rosparam file="$(find main_agv)/params/param/nav/costmap_global_static.yaml" command="load" ns="global_costmap" unless="$(arg no_static_map)"/>
    
    <!-- global costmap with laser, for odom_navigation_demo -->
    <rosparam file="$(find main_agv)/params/param/nav/costmap_global_laser.yaml" command="load" ns="global_costmap" if="$(arg no_static_map)"/>
    <param name="global_costmap/width" value="200.0" if="$(arg no_static_map)"/>
    <param name="global_costmap/height" value="200.0" if="$(arg no_static_map)"/>
    <remap from="cmd_vel" to="raw_cmd_vel"/>

  </node>

</launch>