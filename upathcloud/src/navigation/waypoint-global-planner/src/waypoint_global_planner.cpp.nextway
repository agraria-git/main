void WaypointGlobalPlanner::updatePath(std::vector<geometry_msgs::PoseStamped>& Wpath)
{
/* */
  if (Wpath.size()>=2){
    geometry_msgs::Point pObj1 = Wpath[0].pose.position;
    geometry_msgs::Point pObj2 = Wpath[1].pose.position;
    geometry_msgs::Point pAct = currentPos.pose.position;
    geometry_msgs::Point pOri = originPos.pose.position;

    float dist = sqrt((pObj1.x-pAct.x)*(pObj1.x-pAct.x)+(pObj1.y-pAct.y)*(pObj1.y-pAct.y));

    if (dist<4.0){
      ROS_DEBUG("Distancia al objetivo: %f", dist);
      int segment = nearestSegment(pOri, pObj1, pObj2, pAct);
      if (segment==2 || dist<0.5){
        originPos = Wpath[0];
        Wpath.erase(Wpath.begin());
        if(Wpath.size()>=2){        
          next_way_.x = next_way_.x + 1;
          next_way_pub_.publish(next_way_);}
        if (segment==2)
          ROS_INFO("Waypoint objetivo alcanzado por proximidad al segmento");
        else
          ROS_INFO("Waypoint objetivo alcanzado por proximidad al punto objetivo");
      }
      else if (segment==1){
        ROS_DEBUG("Waypoint objetivo actual no alcanzado");
      }
      else if (segment==-1){
        ROS_DEBUG("No se ha podido encontrar el segmento más cercano");
      }
    }
  }
/* */
}

int WaypointGlobalPlanner::nearestSegment(geometry_msgs::Point P0, geometry_msgs::Point P1, geometry_msgs::Point P2, geometry_msgs::Point pos)
{
  int result = -1;

  if (P1.x==P0.x || P1.x==P2.x) {
  	ROS_DEBUG("No se puede calcular la recta. Dvisión por 0");
  }
  else {
    // Segment P0-P1
    float m1 = (P1.y-P0.y)/(P1.x-P0.x);
    float b1 = P1.y-m1*P1.x;

    // Segment P1-P2
    float m2 = (P2.y-P1.y)/(P2.x-P1.x);
    float b2 = P1.y-m2*P1.x;

    float dist2seg1 = abs(m1*pos.x+b1-pos.y)/sqrt(m1*m1+1);
    float dist2seg2 = abs(m2*pos.x+b2-pos.y)/sqrt(m2*m2+1);
    ROS_DEBUG("Distancia al seg1: %f", dist2seg1);
    ROS_DEBUG("Distancia al seg2: %f", dist2seg2);

    if (dist2seg1 <= dist2seg2){
      if(pointInSegment(pos, P0, P1, m1, b1)){
        result = 1;
        //ROS_DEBUG("If A");
      }
      else if(pointInSegment(pos, P1, P2, m2, b2)){
        result = 2;
        //ROS_INFO("If B");
      }
    }
    else if (dist2seg2 < dist2seg1){
      if(pointInSegment(pos, P1, P2, m2, b2)){
        result = 2;
        //ROS_INFO("If C");
      }
      else if(pointInSegment(pos, P0, P1, m1, b1)){
        result = 1;
        //ROS_INFO("If D");
      }
    }
  }

  return result;
}


bool WaypointGlobalPlanner::pointInSegment(geometry_msgs::Point p, geometry_msgs::Point PIni, geometry_msgs::Point PFin, float m, float b)
{
  float mT = -1/m;
  float bT = p.y-mT*p.x;
  float xT = (bT-b)/(m-mT);

  if ((PIni.x <= xT && xT <= PFin.x) || (PFin.x <= xT && xT <= PIni.x))
    return true;
  else
    return false;
}

}  // namespace waypoint_global_planner
